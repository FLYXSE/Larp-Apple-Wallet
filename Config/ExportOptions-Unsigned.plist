<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Режим unsigned не использует -exportArchive:
	  .app упаковывается в Payload/ и zip-уется вручную (см. .github/workflows/build-ipa.yml).
	  Плаг оставлен как заготовка для ручной упаковки через xcodebuild -exportArchive.
	-->
	<key>method</key>
	<string>development</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>compileBitcode</key>
	<false/>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
